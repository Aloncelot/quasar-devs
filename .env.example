# Copia este archivo a .env.local y completa los valores.
# IMPORTANTE: todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador. No pongas secretos aquí.

# Contacto público
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/tu-usuario
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/tu-perfil/

# Opcionales para captar clientes (si se dejan vacíos, no se muestran)
# WhatsApp con lada país, solo dígitos. Ej. México: 5215512345678
NEXT_PUBLIC_WHATSAPP=
# Enlace para agendar llamada (Calendly, Cal.com, Google Calendar). Debe empezar con https://
NEXT_PUBLIC_BOOKING_URL=

# EmailJS (formulario de contacto). Son identificadores públicos por diseño;
# protégelos desde el panel de EmailJS (ver README: "Seguridad").
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
