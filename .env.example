# Copia este archivo a .env.local y completa los valores.
# IMPORTANTE: todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador. No pongas secretos aquí.

# Contacto público
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/tu-usuario
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/tu-perfil/

# Opcionales para captar clientes (si se dejan vacíos, no se muestran)
# WhatsApp con lada país, solo dígitos. Ej. México: 5215512345678
NEXT_PUBLIC_WHATSAPP=
# Enlace para agendar llamada (Calendly, Cal.com, Google Calendar). Debe empezar con https://
NEXT_PUBLIC_BOOKING_URL=

# EmailJS (formulario de contacto). Solo se usan en el servidor (/api/contact): NO les pongas NEXT_PUBLIC_.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# EmailJS → Account → Security: activa "Use Private Key" y "Allow EmailJS API for non-browser applications".
EMAILJS_PRIVATE_KEY=
# Límites del formulario (opcionales): por visitante por hora y por día, y total diario
CONTACT_PER_HOUR=3
CONTACT_PER_DAY=5
CONTACT_GLOBAL_PER_DAY=20

# Contadores compartidos para los límites (Upstash Redis). En Vercel: Storage → Upstash for Redis → conectar.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Randall (chatbot). URL pública del backend en Python (carpeta randall-api). Debe empezar con https://
# En desarrollo, si se deja vacío, usa http://localhost:8000
NEXT_PUBLIC_RANDALL_API_URL=
